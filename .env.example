# Онлайн-деканат: переменные окружения для развёртывания.
# Рабочий файл — `.env` рядом с этим шаблоном (в репозиторий не попадает: он в .gitignore).
# Docker:   docker run --env-file .env -p 8000:8000 ...    (см. README, раздел Docker)
# Без Docker: переменные из этого файла нужно загрузить в окружение процесса (systemd EnvironmentFile=, `set -a; . ./.env; set +a`).
# Комментарии только на отдельных строках: Docker не понимает комментарий в конце строки со значением.

# ---------------------------------------------------------------- сервер
# в контейнере слушаем все интерфейсы; на голом сервере за nginx оставьте 127.0.0.1
DEKANAT_SERVER_HOST=0.0.0.0
DEKANAT_SERVER_PORT=8000
# false — правку Положения и типов документов из интерфейса выключить совсем (в контейнере так безопаснее)
DEKANAT_SERVER_ALLOW_EDIT=false
# auto — флаг Secure у cookie ставится сам по схеме https; за прокси без передачи схемы поставьте true
DEKANAT_SERVER_COOKIE_SECURE=auto
DEKANAT_SERVER_MAX_UPLOAD_MB=25

# ---------------------------------------------------------------- первый администратор (создаётся при первом запуске)
# Задайте свой пароль не короче 10 символов (пустой пароль — администратор не создаётся; общего пароля по умолчанию нет). После первого входа удалите DEKANAT_ADMIN_PASSWORD из окружения и перезапустите.
DEKANAT_ADMIN_USERNAME=dean
DEKANAT_ADMIN_PASSWORD=

# ---------------------------------------------------------------- языковая модель (по умолчанию выключена)
USE_LOCAL_LLM=false
# адрес Ollama, если модель включена; из контейнера до Ollama на хосте — http://host.docker.internal:11434
DEKANAT_LLM_OLLAMA_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------- Telegram-бот и Mini App (по умолчанию выключено)
DEKANAT_TELEGRAM_ENABLED=false
# токен выдаёт @BotFather; нигде, кроме этого файла (или переменной окружения), его хранить нельзя
DEKANAT_TELEGRAM_BOT_TOKEN=
# https-адрес сайта: нужен для кнопки Mini App и для режима webhook
DEKANAT_TELEGRAM_PUBLIC_URL=

# ---------------------------------------------------------------- отправка обращений
# queue — внутренняя очередь (видна в кабинете); none — автоматическая отправка выключена
DEKANAT_DELIVERY_CHANNEL=queue
# письмо студенту с номером и кодом статуса (по умолчанию выключено)
DEKANAT_MAIL_ENABLED=false
DEKANAT_MAIL_HOST=
DEKANAT_MAIL_PORT=587
DEKANAT_MAIL_USERNAME=
DEKANAT_MAIL_FROM=
DEKANAT_MAIL_PASSWORD=
# адрес сайта для ссылки в письме
DEKANAT_MAIL_PUBLIC_URL=

# ---------------------------------------------------------------- OCR
# Docker-образ приносит свой Tesseract с русским; на сервере без Docker укажите путь, если он не в PATH
TESSERACT_CMD=
